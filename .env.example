# PromptGuard AI — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ─── Backend ──────────────────────────────────────────────────────────────────
PROMPTGUARD_PORT=8000
PROMPTGUARD_HOST=0.0.0.0
PROMPTGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PROMPTGUARD_LOG_LEVEL=info
PROMPTGUARD_AUDIT_MAX_EVENTS=500
PROMPTGUARD_MAX_CONTENT_LENGTH=100000

# ─── API Authentication ───────────────────────────────────────────────────────
# Enable API key auth for production deployments
PROMPTGUARD_API_AUTH_ENABLED=false
# Comma-separated list of valid API keys
PROMPTGUARD_API_KEYS=

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Path to SQLite database for policy persistence
PROMPTGUARD_DATABASE_PATH=./data/promptguard.db

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# Comma-separated webhook URLs for real-time alerts
PROMPTGUARD_WEBHOOK_URLS=
# Which decisions trigger webhooks (comma-separated)
PROMPTGUARD_WEBHOOK_EVENTS=DENY,HUMAN_REVIEW

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173

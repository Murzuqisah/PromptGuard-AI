# PromptGuard AI — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ─── Backend ──────────────────────────────────────────────────────────────────
PROMPTGUARD_PORT=8000
PROMPTGUARD_HOST=0.0.0.0
PROMPTGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PROMPTGUARD_LOG_LEVEL=info
PROMPTGUARD_AUDIT_MAX_EVENTS=500
PROMPTGUARD_MAX_CONTENT_LENGTH=100000

# ─── API Authentication ───────────────────────────────────────────────────────
# Enable API key auth for production deployments
PROMPTGUARD_API_AUTH_ENABLED=false
# Comma-separated list of valid API keys
PROMPTGUARD_API_KEYS=

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Path to SQLite database for policy persistence
PROMPTGUARD_DATABASE_PATH=./data/promptguard.db

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# Comma-separated webhook URLs for real-time alerts
PROMPTGUARD_WEBHOOK_URLS=
# Which decisions trigger webhooks (comma-separated)
PROMPTGUARD_WEBHOOK_EVENTS=DENY,HUMAN_REVIEW

# ─── Rate Limiting ────────────────────────────────────────────────────────────
PROMPTGUARD_RATE_LIMIT_ENABLED=true
# Max requests per window per client (IP or API key)
PROMPTGUARD_RATE_LIMIT_REQUESTS=60
# Window size in seconds
PROMPTGUARD_RATE_LIMIT_WINDOW=60

# ─── RBAC ─────────────────────────────────────────────────────────────────────
# Map API keys to roles. Format: key1:admin,key2:analyst,key3:viewer
PROMPTGUARD_API_KEY_ROLES=
# Map API keys to tenants. Format: key1:tenant-a,key2:tenant-b
PROMPTGUARD_API_KEY_TENANTS=

# ─── SIEM Connectors ─────────────────────────────────────────────────────────
# Splunk HTTP Event Collector
PROMPTGUARD_SPLUNK_HEC_URL=
PROMPTGUARD_SPLUNK_HEC_TOKEN=

# AWS CloudWatch Logs
PROMPTGUARD_CLOUDWATCH_LOG_GROUP=
PROMPTGUARD_CLOUDWATCH_LOG_STREAM=promptguard-events
PROMPTGUARD_CLOUDWATCH_REGION=us-east-1

# Datadog
PROMPTGUARD_DATADOG_API_KEY=
PROMPTGUARD_DATADOG_SITE=datadoghq.com

# Elasticsearch / OpenSearch
PROMPTGUARD_ELASTIC_URL=
PROMPTGUARD_ELASTIC_INDEX=promptguard-events
PROMPTGUARD_ELASTIC_API_KEY=

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173

    "/v1/stats": {
      "get": {
        "tags": [
          "Metrics"
        ],
        "summary": "Security metrics",
        "description": "Security metrics for dashboards.\n\nReturns total scan count, decision breakdown, override count, threat detection rate,\nand AI status. Poll this endpoint to feed Grafana, Datadog, or custom dashboards.",
        "operationId": "stats_v1_stats_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
